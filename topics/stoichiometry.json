    {
      "id": "L3",
      "title": "Limiting Reagent & Yield",
      "requiredCorrect": 3,
      "drawMode": "random",
      "raceCount": 2,
      "questions": [
        {
          "id": "L3-Q01",
          "prompt": "For N_2 + 3 H_2 -> 2 NH_3, you start with 28.0 g of N_2 and 3.00 g of H_2. Which reactant is limiting?",
          "answer": {
            "type": "formula",
            "value": "H_2",
            "match": "composition",
            "charge": 0
          },
          "hints": [
            "Convert both masses to moles.",
            "Compare the available mole ratio to the 1:3 required ratio."
          ],
          "explanation": "1.00 mol N_2 needs 3.00 mol H_2, but only 1.49 mol H_2 is present, so H_2 runs out first.",
          "tags": [
            "limiting-reagent"
          ],
          "expectedSeconds": 120,
          "points": 15
        },
        {
          "id": "L3-Q02",
          "prompt": "Using the amounts from the previous question, what is the theoretical yield of NH_3 in grams?",
          "answer": {
            "type": "numeric",
            "value": 16.9,
            "unit": "g",
            "tolerance": {
              "type": "relative",
              "value": 0.02
            },
            "sigFigs": 3,
            "sigFigPolicy": "warn"
          },
          "hints": [
            "Work from the limiting reagent.",
            "n(NH_3) = n(H_2) x 2/3"
          ],
          "explanation": "1.488 mol H_2 x (2/3) = 0.992 mol NH_3; 0.992 x 17.03 = 16.9 g",
          "tags": [
            "limiting-reagent",
            "theoretical-yield"
          ],
          "expectedSeconds": 150,
          "points": 20,
          "feedback": {
            "commonErrors": [
              {
                "match": {
                  "type": "numeric",
                  "value": 34.1,
                  "tolerance": {
                    "type": "relative",
                    "value": 0.02
                  }
                },
                "message": "You used N_2 as the limiting reagent. Go back and compare the mole ratios.",
                "label": "wrong-limiting-reagent"
              },
              {
                "match": {
                  "type": "numeric",
                  "value": 25.3,
                  "tolerance": {
                    "type": "relative",
                    "value": 0.02
                  }
                },
                "message": "Check your mole ratio. It is 2 NH_3 per 3 H_2, not 1 per 1.",
                "label": "mole-ratio-ignored"
              }
            ]
          }
        },
        {
          "id": "L3-Q03",
          "prompt": "If the reaction above actually produces 12.5 g of NH_3, what is the percent yield?",
