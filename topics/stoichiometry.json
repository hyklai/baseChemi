          "explanation": "4 Al + 3 O_2 -> 2 Al_2O_3",
          "tags": [
            "balancing"
          ],
          "expectedSeconds": 60,
          "points": 10
        },
        {
          "id": "L2-Q02",
          "prompt": "Write the balanced equation for the complete combustion of propane, C_3H_8. Phases are not required.",
          "answer": {
            "type": "equation",
            "value": "C_3H_8 + 5 O_2 -> 3 CO_2 + 4 H_2O",
            "requireBalanced": true,
            "requireLowest": true,
            "requirePhases": false,
            "allowReorder": true,
            "arrow": "yields"
          },
          "hints": [
