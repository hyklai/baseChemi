  "levels": [
    {
      "id": "L1",
      "title": "Formulas & Molar Mass",
      "requiredCorrect": 3,
      "drawMode": "random",
      "raceCount": 2,
      "questions": [
        {
          "id": "L1-Q01",
          "prompt": "Write the chemical formula for aluminum sulfate.",
          "answer": {
            "type": "formula",
            "value": "Al_2(SO_4)_3",
            "match": "composition",
            "charge": 0
          },
          "hints": [
            "Al forms a 3+ ion; sulfate is SO_4^2-.",
            "Cross the charges over."
          ],
          "explanation": "Al^3+ and SO_4^2- combine in a 2:3 ratio to give Al_2(SO_4)_3.",
          "tags": [
            "nomenclature",
            "ionic"
          ],
          "expectedSeconds": 45,
          "points": 10,
          "feedback": {
            "commonErrors": [
              {
                "match": {
                  "type": "formula",
                  "value": "Al_3(SO_4)_2",
                  "match": "composition"
                },
                "message": "You crossed the charges the wrong way. The 3+ charge on Al becomes the subscript on sulfate.",
                "label": "charge-crossover-reversed"
              },
              {
                "match": {
                  "type": "formula",
                  "value": "AlSO_4",
                  "match": "composition"
                },
                "message": "Check the charges. A 3+ cation and a 2- anion cannot pair 1:1.",
                "label": "no-charge-balance"
              }
            ]
          }
        },
        {
          "id": "L1-Q02",
          "prompt": "What is the molar mass of Ca(OH)_2? Report to 4 significant figures.",
          "answer": {
            "type": "numeric",
            "value": 74.1,
            "unit": "g/mol",
            "tolerance": {
              "type": "absolute",
              "value": 0.05
            },
            "sigFigs": 4,
            "sigFigPolicy": "warn",
            "unitAliases": [
              "g/mol",
              "g mol^-1",
              "grams per mole"
            ]
          },
          "hints": [
            "Remember the subscript 2 applies to the entire hydroxide group."
          ],
          "explanation": "40.08 + 2(16.00 + 1.008) = 74.10 g/mol",
          "tags": [
            "molar-mass"
          ],
          "expectedSeconds": 60,
          "points": 10,
          "feedback": {
            "commonErrors": [
              {
                "match": {
                  "type": "numeric",
                  "value": 57.09,
                  "tolerance": {
                    "type": "absolute",
                    "value": 0.05
                  }
                },
                "message": "You only counted one hydroxide. The subscript 2 multiplies both O and H.",
                "label": "subscript-not-distributed"
              }
            ]
          }
        },
        {
          "id": "L1-Q03",
          "prompt": "How many moles are in 12.5 g of CaCO_3?",
          "answer": {
            "type": "numeric",
            "value": 0.1249,
            "unit": "mol",
            "tolerance": {
              "type": "relative",
              "value": 0.01
            },
            "sigFigs": 3,
            "sigFigPolicy": "warn"
          },
          "hints": [
            "Find the molar mass first.",
            "M(CaCO_3) = 100.09 g/mol"
          ],
          "explanation": "n = m / M = 12.5 / 100.09 = 0.125 mol",
          "tags": [
            "mole",
            "molar-mass"
          ],
          "expectedSeconds": 75,
          "points": 10,
          "feedback": {
            "commonErrors": [
              {
                "match": {
                  "type": "numeric",
                  "value": 1251,
                  "tolerance": {
                    "type": "relative",
                    "value": 0.02
                  }
                },
                "message": "You multiplied by the molar mass instead of dividing. Check your unit cancellation.",
                "label": "inverted-molar-mass"
              }
            ]
          }
        },
        {
          "id": "L1-Q04",
          "prompt": "Which of the following is an ionic compound?",
